# ANIWAVE ENVIRONMENT CONFIGURATION
# Copy this file to .env or inject into CI/CD build environments

# Brand Customization (White-Label)
VITE_SITE_NAME="Aniwave"
VITE_CREATOR_NAME="TzRIO"
VITE_SITE_URL="https://tzrio.github.io/Aniwave"
VITE_DEFAULT_THEME="dark"

# Administrator Root Credentials (Change in Production)
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASS="admin123"

# Third-party APIs
JIKAN_API_BASE="https://api.jikan.moe/v4"
ENABLE_LIVE_MAL_LOOKUP=true

# Monetization & Analytics
ENABLE_AFFILIATE_SLOTS=true
CRUNCHYROLL_AFFILIATE_ID=""
GOOGLE_ANALYTICS_ID=""
